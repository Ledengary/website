---
// One paper on /research: figure thumbnail on the left; title, authors, meta and links on the right.
// The figure comes from src/assets/papers/<id>.(png|jpg|jpeg|webp) and is shown whole (never cropped);
// without one, a placeholder is drawn.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  paper: CollectionEntry<'publications'>;
}

const figures = import.meta.glob<ImageMetadata>('/src/assets/papers/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const figureFor = (id: string) =>
  Object.entries(figures).find(([path]) => path.replace(/^.*\/|\.[^.]+$/g, '') === id)?.[1];

const TYPE: Record<string, string> = {
  'main-conference': 'Main conference',
  conference: 'Conference',
  journal: 'Journal',
  abstract: 'Abstract',
  preprint: 'Preprint',
};
const TAG: Record<string, string> = { 'core-cs': 'Core CS', oncology: 'Oncology', medical: 'Medical', finance: 'Finance' };
// Button order: the paper itself (published version, then arXiv), then code, then data, then anything else.
const LINKS = [
  ['paper', 'Paper'],
  ['arxiv', 'arXiv'],
  ['code', 'Code'],
  ['data', 'Data'],
  ['video', 'Video'],
] as const;

const { id, data: p } = Astro.props.paper;
const main = p.links.paper ?? p.links.arxiv;
// Media coverage of this paper (src/data/media.yaml, matched by related_paper), oldest first.
const media = (await getCollection('media')).map((m) => m.data).filter((m) => m.related_paper === id).sort((a, b) => a.date.localeCompare(b.date));
const figure = figureFor(id);
const isMe = (name: string) => /khan\s*mohammadi/i.test(name);
const etAl = p.authors.at(-1) === 'et al.';
const authors = etAl ? p.authors.slice(0, -1) : p.authors;
// Each link's icon comes from where it points; anything else (publisher, DOI, Anthology) is a paper.
const iconFor = (url: string): IconName =>
  /github\.com/.test(url) ? 'github'
  : /huggingface\.co/.test(url) ? 'huggingface'
  : /arxiv\.org/.test(url) ? 'arxiv'
  : /youtube\.com|youtu\.be/.test(url) ? 'youtube'
  : 'paper';
const links = LINKS.filter(([key]) => p.links[key]).map(([key, label]) => ({ url: p.links[key]!, label, icon: iconFor(p.links[key]!) }));
const Fig = main ? 'a' : 'span';
// Preprints show just the year (the arXiv link says where it lives).
const venue = [p.type === 'preprint' ? undefined : p.venue_short, p.year].filter(Boolean).join(' ');
---

<li class="paper" id={id}>
  {/* The thumbnail repeats the title link, so it is hidden from screen readers and the tab order. */}
  <Fig class="paper__fig" href={main} tabindex={main ? '-1' : undefined} aria-hidden="true">
    {
      figure ? (
        <Image class="paper__img" src={figure} alt="" width={480} />
      ) : (
        <svg class="paper__ph" viewBox="0 0 168 105">
          <rect width="168" height="105" fill="#ECF4F6" />
          <g fill="none" stroke="#0E7490" stroke-opacity="0.16" stroke-width="1">
            <path d="M18 78 L50 52 L84 64 L118 34 L150 44" />
            <path d="M18 88 H150" />
          </g>
          <g fill="#0E7490" fill-opacity="0.2">
            <circle cx="50" cy="52" r="3" />
            <circle cx="84" cy="64" r="3" />
            <circle cx="118" cy="34" r="3" />
          </g>
          <text x="84" y="25" text-anchor="middle" class="paper__ph-label">{p.short_name}</text>
        </svg>
      )
    }
  </Fig>

  <div class="paper__body">
    <h4 class="paper__title">{main ? <a href={main}>{p.title}</a> : p.title}</h4>
    <p class="paper__authors">
      {authors.map((a, i) => (
        <Fragment>
          {i > 0 && ', '}
          {isMe(a) ? <strong>{a}</strong> : a}
        </Fragment>
      ))}
      {etAl && ' et al.'}
    </p>
    {/* Meta on the left, links on the right; the links drop to their own line when it doesn't fit.
        With media coverage, the facts get their own line and "In the media" takes the links' row. */}
    {media.length > 0 && <div class="paper__meta"><p class="paper__facts">
        {venue && <span class="paper__venue" title={p.venue_full}>{venue}</span>}
        <span class="badge">{TYPE[p.type]}</span>
        {p.tags.map((t) => <span class="chip">{TAG[t]}</span>)}
        {p.highlight && <span class="paper__highlight">{p.highlight}</span>}
        {p.status_note && <span class="paper__status">{p.status_note}</span>}
      </p></div>}
    <div class="paper__meta">
      {media.length > 0 ? (
        <div class="paper__media">
          In the media:{' '}
          <ul class="dots">
            {media.map((m) => <li><a href={m.url}>{m.outlet_short}</a></li>)}
          </ul>
        </div>
      ) : (
        <p class="paper__facts">
        {venue && <span class="paper__venue" title={p.venue_full}>{venue}</span>}
        <span class="badge">{TYPE[p.type]}</span>
        {p.tags.map((t) => <span class="chip">{TAG[t]}</span>)}
        {p.highlight && <span class="paper__highlight">{p.highlight}</span>}
        {p.status_note && <span class="paper__status">{p.status_note}</span>}
      </p>
      )}
      {
        links.length > 0 && (
          <ul class="paper__links">
            {links.map((l) => <li><a class="link-btn link-btn--sm" href={l.url}><Icon name={l.icon} />{l.label}</a></li>)}
          </ul>
        )
      }
    </div>
  </div>
</li>
