  <section class="section section--page">
    <div class="section__inner">
      <h1 class="section__title section__title--rule">Page not found</h1>
      <p class="page-intro">The page you're looking for doesn't exist or has moved.</p>
      <p class="notfound__links">
        <a class="link-btn" href="/">Home</a>
        <a class="link-btn" href="/about/">About</a>
        <a class="link-btn" href="/research/">Research</a>
      </p>
    </div>
  </section>
</Base>
